generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("users")
  @@schema("public")
}
/// Tabela gerenciada pelo Supabase — não editar
model AuthUser {
  id String @id @db.Uuid

  // Relações inversas (necessárias para o Prisma resolver as FKs)
  budgets          Budget[]
  expenses         Expense[]
  incomes          Income[]
  userAuthMethods  UserAuthMethod[]

  @@map("users")
  @@schema("auth")
  @@ignore
}
model Budget {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  // outros campos...
  createdAt DateTime @default(now())

  user AuthUser @relation(fields: [userId], references: [id]) @ignore

  @@map("budgets")
  @@schema("public")
}

model Expense {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  // outros campos...
  createdAt DateTime @default(now())

  user AuthUser @relation(fields: [userId], references: [id]) @ignore

  @@map("expenses")
  @@schema("public")
}

model Income {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  // outros campos...
  createdAt DateTime @default(now())

  user AuthUser @relation(fields: [userId], references: [id]) @ignore

  @@map("incomes")
  @@schema("public")
}

model UserAuthMethod {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  method    String
  isActive  Boolean @default(false)
  createdAt DateTime @default(now())

  user AuthUser @relation(fields: [userId], references: [id]) @ignore

  @@unique([userId, method])
  @@map("user_auth_methods")
  @@schema("public")
}
